# Copiar a .env (ignorado por git).
# PRIVATE_KEY debe ser de una wallet de testnet NUEVA y desechable, nunca una personal.
PRIVATE_KEY=
RPC_URL=https://testnet-rpc.monad.xyz
# Dirección pública del agente de IA (el servidor firma con su clave; esa clave va en app/.env.local, no aquí).
AGENT_ADDRESS=
# Tope fijo, en MON, del pago autónomo por cliente (unos 100.000 USD; con MON a 0,02 USD son 5.000.000).
MAX_AUTO_RELEASE_MON=5000000
