# Copiar a .env.local (ignorado por git). No poner valores reales aquí.
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
# Dirección impresa al desplegar el contrato
NEXT_PUBLIC_CONTRACT_ADDRESS=
# URL del servicio de IA en Python (solo servidor, sin prefijo NEXT_PUBLIC_)
AI_API_URL=http://127.0.0.1:8000

# Supabase (solo servidor). El host directo db.<ref>.supabase.co es solo IPv6: usar siempre el pooler.
# Región y host: Supabase > Connect > Transaction pooler.
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
# App: pooler en modo transacción (puerto 6543).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Migraciones (pnpm db:migrate): pooler en modo sesión (puerto 5432).
DATABASE_URL_SESSION=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Supabase Auth (Google y GitHub). Solo servidor: el navegador nunca habla con Supabase, todo pasa por /api/auth/*.
# Project Settings > API: URL del proyecto y clave publishable (o anon).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Orígenes del frontend a los que se puede volver tras iniciar sesión, separados por coma. El primero es el predeterminado.
FRONTEND_ORIGINS=http://localhost:3000
# Máximo de conexiones por instancia de la app hacia el pooler (el servidor admite 60 en total).
DB_POOL_MAX=5
# Opcional: certificado CA de Supabase (PEM) para verificar TLS en lugar de solo cifrar.
DB_SSL_CA=
