# Copiar a .env.local (ignorado por git). No poner valores reales aquí.

# --- Red y contrato ---
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
# Dirección y bloque de despliegue que imprime `forge script script/Deploy.s.sol` (el indexador empieza en ese bloque).
NEXT_PUBLIC_CONTRACT_ADDRESS=
CONTRACT_DEPLOY_BLOCK=
# Bloque que el indexador considera confirmado: "finalized" en Monad; "latest" solo en cadenas locales (anvil).
INDEXER_BLOCK_TAG=finalized

# --- Agente de IA de PACT (solo servidor) ---
# Clave de una wallet NUEVA que solo ejecuta releaseByAgent. Su dirección es AGENT_ADDRESS en contracts/.env.
# Necesita un poco de MON para el gas. Nunca la misma wallet que despliega ni una personal.
AGENT_PRIVATE_KEY=

# --- Servicio de IA (repo pact-ai) ---
AI_API_URL=http://127.0.0.1:8000
# Mismo valor que PACT_AI_SHARED_SECRET en pact-ai. Obligatorio si el servicio de IA tiene URL pública.
AI_API_SECRET=

# --- Supabase (solo servidor) ---
# El host directo db.<ref>.supabase.co es solo IPv6: usar siempre el pooler (Supabase > Connect > Transaction pooler).
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Migraciones (pnpm db:migrate): pooler en modo sesión (puerto 5432).
DATABASE_URL_SESSION=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Máximo de conexiones por instancia de la app hacia el pooler (el servidor admite 60 en total).
DB_POOL_MAX=5
# Opcional: certificado CA de Supabase (PEM) para verificar TLS en lugar de solo cifrar.
DB_SSL_CA=
# Archivos (briefs, portafolio, evidencia). service_role se salta RLS: solo en servidor, nunca con NEXT_PUBLIC_.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=pact-files

# --- Créditos de IA ---
# Wallet de la empresa que recibe el MON de la compra de créditos.
TREASURY_ADDRESS=
CREDIT_PRICE_MON=0.1
MONTHLY_FREE_CREDITS=20
